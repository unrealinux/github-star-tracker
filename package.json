{
  "name": "github-star-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:postgres": "DB_DRIVER=postgres node --test tests/*.test.js",
    "test:frontend": "node --test tests/frontend.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:postgres": "DB_DRIVER=postgres node server.js",
    "migrate:postgres": "node scripts/migrate-to-postgres.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^4.6.0"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.9"
  }
}
