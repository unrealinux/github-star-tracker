# ── GitHub ──────────────────────────────────────────────────────────
# 个人访问令牌（强烈建议）。未配置时搜索配额仅约 10 次/分钟。
# 生成: https://github.com/settings/tokens  →  Generate new token (classic)
# 无需勾选任何权限，仅用于提升 API 配额。
GITHUB_TOKEN=

# 回退变量：GITHUB_TOKEN 为空时才会读它。
# 已经用 gh CLI 登录过的话，可直接填 `gh auth token` 的输出，省去手建 token。
GH_TOKEN=

# ── 服务 ────────────────────────────────────────────────────────────
# 监听端口
PORT=3001

# 访问控制（可选）。设置后所有 /api/* 需携带请求头 X-API-Key
# 部署到公网时务必设置一个足够随机的值。不接受 ?key= 查询参数。
API_KEY=

# 只读订阅令牌（可选）。启用 API_KEY 后，RSS 阅读器无法带请求头，
# 此时设置此值并订阅 /api/feed/*.xml?token=<FEED_TOKEN>。
# 权限仅限订阅接口，可安全出现在 URL 中。
FEED_TOKEN=

# ── 定时抓取 ────────────────────────────────────────────────────────
# cron 表达式（分 时 日 月 周），服务器时区
#   0 9 * * *      -> 每天 09:00（默认）
#   */30 * * * *   -> 每 30 分钟
#   0 */6 * * *    -> 每 6 小时
CRON_SCHEDULE=0 9 * * *

# ── 日志 ────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# 设为 json 可输出 JSON 行日志（便于采集）
LOG_FORMAT=

# ── 其他运行时设置 ──────────────────────────────────────────────────
# 以下项也可在网页「设置」Tab 中修改（存入数据库，优先于此处默认值）：
#   最低星数 / 增速下限 / 快照保留天数 / 告警阈值 /
#   自动轮询间隔 / 自定义搜索语法 / Webhook 地址与类型 / 主题
