# GitHub 个人访问令牌（可选，强烈建议）。未配置时使用匿名请求，搜索配额低（约 10 次/分钟）。
# 生成方式: GitHub -> Settings -> Developer settings -> Personal access tokens (classic) -> 勾选 public_repo
GITHUB_TOKEN=

# 服务端口
PORT=3001

# 定时自动抓取的 cron 表达式（分 时 日 月 周）。默认每天 09:00 抓一次。
# 例：
#   0 9 * * *        -> 每天 09:00
#   */30 * * * *     -> 每 30 分钟
#   0 0 * * *        -> 每天 00:00
CRON_SCHEDULE=0 9 * * *
